# Copy to .env and edit
PORT=4000
# Local MongoDB, or a free Atlas cluster string: mongodb+srv://user:pass@cluster.mongodb.net/life-os
MONGODB_URI=mongodb://127.0.0.1:27017/life-os
# Optional: if set, every /api request (except /api/health) must send the header  x-api-key: <value>
# Enter the same value in the app under Settings → Data & sync → API key.
API_KEY=
# Comma-separated list of browser origins allowed to call the API (not needed in dev; Vite proxies /api)
CORS_ORIGIN=http://localhost:5173
